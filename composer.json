{
    "name": "infernalmedia/laravel-favicon-generator",
    "description": "Package to generate favicons within your Laravel application.",
    "keywords": [
        "InfernalMedia",
        "laravel",
        "favicon",
        "laravel-favicon-generator"
    ],
    "homepage": "https://github.com/infernalmedia/laravel-favicon-generator",
    "license": "MIT",
    "authors": [
        {
            "name": "Guillaume Ernst",
            "email": "guillaume.ernst@infernal.media",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "intervention/image": "^4.3",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/extension-installer": "^1.4|^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5.8|^13.0.0"
    },
    "autoload": {
        "psr-4": {
            "InfernalMedia\\LaravelFaviconGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InfernalMedia\\LaravelFaviconGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InfernalMedia\\LaravelFaviconGenerator\\LaravelFaviconGeneratorServiceProvider"
            ],
            "aliases": {
                "LaravelFaviconGenerator": "InfernalMedia\\LaravelFaviconGenerator\\Facades\\LaravelFaviconGenerator"
            }
        }
    },
    "prefer-stable": true
}
